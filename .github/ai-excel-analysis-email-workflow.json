      "parameters": {
        "jsCode": "const row = $json;\nconst headers = row.headers || {};\nlet setCookie = headers['set-cookie'] || headers['Set-Cookie'];\nif (Array.isArray(setCookie)) setCookie = setCookie[0];\n\nconst authCookie = setCookie ? String(setCookie).split(';')[0] : '';\nconst accessToken = row.access_token || row.body?.access_token || '';\nconst authBearer = accessToken ? `Bearer ${accessToken}` : '';\n\nif (!authCookie && !authBearer) {\n  throw new Error('Login succeeded but no set-cookie or access_token found.');\n}\n\nreturn [{ json: { auth_cookie: authCookie, auth_bearer: authBearer } }];"
