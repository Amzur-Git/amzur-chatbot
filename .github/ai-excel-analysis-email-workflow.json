    {
      "parameters": {
        "jsCode": "const question = $node[\"Normalize Input\"].json.question;\nconst inputThreadId = $node[\"Normalize Input\"].json.chat_thread_id || '';\nconst payload = $json.body ?? $json;\n\nconst responseThreadId = payload.chat_thread_id\n  ?? payload.thread_id\n  ?? payload.result?.chat_thread_id\n  ?? payload.result?.thread_id\n  ?? '';\n\nconst threadId = inputThreadId || responseThreadId || '';\n\nconst analysis = payload.answer\n  ?? payload.analysis\n  ?? payload.response\n  ?? payload.result?.answer\n  ?? payload.result?.analysis\n  ?? JSON.stringify(payload.result ?? payload, null, 2);\n\nconst shape = payload.dataframe_shape\n  ?? payload.result?.dataframe_shape\n  ?? payload.shape\n  ?? 'N/A';\n\nlet columns = payload.columns\n  ?? payload.result?.columns\n  ?? payload.result?.column_names\n  ?? [];\n\nif (!Array.isArray(columns)) {\n  if (typeof columns === 'string') {\n    columns = columns.split(',').map(c => c.trim()).filter(Boolean);\n  } else {\n    columns = [];\n  }\n}\n\nconst columnsText = columns.length ? columns.join(', ') : 'N/A';\n\nconst html = `\n<h2>AI Excel Analysis Results</h2>\n<p><strong>Question:</strong> ${question}</p>\n<p><strong>AI Analysis:</strong></p>\n<pre style=\"white-space: pre-wrap; font-family: Arial, sans-serif;\">${String(analysis)}</pre>\n<hr />\n<p><strong>DataFrame Shape:</strong> ${String(shape)}</p>\n<p><strong>Columns:</strong> ${columnsText}</p>\n<p><strong>Thread ID:</strong> ${threadId || 'N/A'}</p>\n`;\n\nconst textBody = [\n  `Question: ${question}`,\n  '',\n  'AI Analysis:',\n  String(analysis),\n  '',\n  `DataFrame Shape: ${String(shape)}`,\n  `Columns: ${columnsText}`,\n  `Thread ID: ${threadId || 'N/A'}`\n].join('\\n');\n\nreturn [{\n  json: {\n    question,\n    analysis_text: String(analysis),\n    dataframe_shape: String(shape),\n    columns,\n    thread_id: threadId,\n    email_html: html,\n    text_body: textBody\n  }\n}];"
      },
