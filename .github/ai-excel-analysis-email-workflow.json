        "jsCode": "const inJson = $json || {};\nconst body = (inJson.body && typeof inJson.body === 'object') ? inJson.body : {};\n\nconst pick = (a, b, fallback = '') => {\n  if (a !== undefined && a !== null && String(a).trim() !== '') return String(a).trim();\n  if (b !== undefined && b !== null && String(b).trim() !== '') return String(b).trim();\n  return fallback;\n};\n\nreturn [{\n  json: {\n    backend_base_url: pick(inJson.backend_base_url, body.backend_base_url, 'http://127.0.0.1:8001'),\n    service_email: pick(inJson.service_email, body.service_email, 'james.bond@gmail.com'),\n    service_password: pick(inJson.service_password, body.service_password, 'Martini@007'),\n    file_id: pick(inJson.file_id, body.file_id, 'a085bc3e-34b4-468f-91b9-db2a28abe09c'),\n    question: pick(inJson.question, body.question, 'Provide a concise analysis of this dataset and key insights.'),\n    recipient_email: pick(inJson.recipient_email, body.recipient_email, 'sankalp.bajpai@amzur.com'),\n    email_subject: pick(inJson.email_subject, body.email_subject, 'AI Excel Analysis Results'),\n    chat_thread_id: pick(inJson.chat_thread_id, body.chat_thread_id, 'a272598e-b233-47c5-ab46-449ef892b6e4')\n  }\n}];"
