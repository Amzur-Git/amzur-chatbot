      "id": "get_thread_messages",
      "name": "Get Thread Messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        1220,
        130
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const run = $items('Run Project13 Orchestrator')[0].json;\nconst messages = items[0].json;\nconst digestMessageId = run.digest_message_id || null;\nlet digestText = null;\nif (Array.isArray(messages) && digestMessageId) {\n  const found = messages.find(m => String(m.id) === String(digestMessageId));\n  digestText = found?.content || null;\n}\nconst backend = $items('Normalize Input')[0].json.backend_base_url;\nconst imageAttachmentId = run.image_attachment_id || null;\nconst imageUrl = imageAttachmentId ? `${backend}/api/attachments/${imageAttachmentId}/download` : null;\nconst textFallback = 'Image generation unavailable in this run. Text digest is provided.';\nreturn [{\n  json: {\n    run_id: run.run_id || null,\n    status: run.status || null,\n    topic: run.topic || null,\n    digest_message_id: digestMessageId,\n    image_message_id: run.image_message_id || null,\n    image_attachment_id: imageAttachmentId,\n    errors: run.errors || [],\n    step_results: run.step_results || {},\n    final_digest_text: digestText || '(Digest message not found in thread history.)',\n    image_url: imageUrl,\n    text_fallback: textFallback\n  }\n}];"
      },
