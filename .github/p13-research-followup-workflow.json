    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const run = $items('Run Project13 Orchestrator')[0].json || {};\nconst followup = $items('Send Follow-up Question')[0].json || {};\n\nlet messages = [];\nif (items.length === 1 && Array.isArray(items[0].json)) {\n  messages = items[0].json;\n} else if (Array.isArray(items)) {\n  messages = items.map(i => i.json).filter(v => v && typeof v === 'object' && v.id && v.role);\n}\n\nlet latestAssistant = null;\nif (messages.length > 0) {\n  const assistantMessages = messages.filter(m => m.role === 'assistant');\n  latestAssistant = assistantMessages.length ? assistantMessages[assistantMessages.length - 1] : null;\n}\n\nconst followupText = followup.content || latestAssistant?.content || null;\n\nreturn [{\n  json: {\n    final_status: 'success',\n    run_id: run.run_id || null,\n    topic: run.topic || null,\n    workflow_status: run.status || null,\n    resolved_thread_id: $items('Resolve Thread Context')[0].json.resolved_thread_id,\n    digest_message_id: run.digest_message_id || null,\n    image_message_id: run.image_message_id || null,\n    image_attachment_id: run.image_attachment_id || null,\n    followup_message_id: followup.id || latestAssistant?.id || null,\n    followup_answer: followupText || '(No follow-up answer returned.)',\n    errors: run.errors || [],\n    thread_message_count: messages.length\n  }\n}];"
      },
