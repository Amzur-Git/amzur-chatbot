        "url": "={{$node['Normalize Input'].json.backend_base_url + '/api/chat/threads/' + $node['Resolve Thread Context'].json.resolved_thread_id + '/messages'}}",
        "method": "GET",
        "jsonParameters": true,
        "headerParametersJson": "={\n  \"Cookie\": $node['Resolve Thread Context'].json.auth_cookie\n}",
        "options": {}
