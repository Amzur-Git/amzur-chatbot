      "id": "if_auth_ok",
      "name": "Auth OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        -320,
        130
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const row = items[0].json;\nconst headers = row.headers || {};\nlet setCookie = headers['set-cookie'] || headers['Set-Cookie'];\nif (Array.isArray(setCookie)) setCookie = setCookie[0];\nif (!setCookie) throw new Error('Login succeeded but no set-cookie header found.');\nconst authCookie = String(setCookie).split(';')[0];\nreturn [{ json: { auth_cookie: authCookie } }];"
      },
      "id": "extract_cookie",
      "name": "Extract Cookie",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -100,
        60
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$node['Normalize Input'].json.chat_thread_id || ''}}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{$node['Normalize Input'].json.chat_thread_id || ''}}",
              "operation": "notEqual",
              "value2": "AUTO_CREATE"
            }
          ]
        }
      },
      "id": "if_thread_id_provided",
      "name": "Thread ID Provided?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        120,
        170
      ]
    },
    {
      "parameters": {
        "url": "={{$node['Normalize Input'].json.backend_base_url + '/api/chat/threads'}}",
        "method": "POST",
        "jsonParameters": true,
        "headerParametersJson": "={\n  \"Cookie\": $node['Extract Cookie'].json.auth_cookie,\n  \"Content-Type\": \"application/json\"\n}",
        "bodyParametersJson": "={\n  \"title\": `Research + Follow-up - ${$node['Normalize Input'].json.topic || 'Auto Thread'}`\n}",
        "options": {}
      },
      "id": "create_thread",
      "name": "Create Thread",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        340,
        250
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const providedRaw = $items('Normalize Input')[0].json.chat_thread_id || '';\nconst provided = providedRaw === 'AUTO_CREATE' ? '' : providedRaw;\nconst created = $json.id || '';\nconst resolved = provided || created;\nif (!resolved) {\n  throw new Error('No chat_thread_id available and thread creation did not return an id.');\n}\nconst authCookie = $items('Extract Cookie')[0].json.auth_cookie;\nreturn [{ json: { auth_cookie: authCookie, resolved_thread_id: resolved } }];"
      },
      "id": "resolve_thread_context",
      "name": "Resolve Thread Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        170
      ]
    },
    {
      "parameters": {
        "url": "={{$node['Normalize Input'].json.backend_base_url + '/api/workflows/research-image-run'}}",
        "method": "POST",
        "jsonParameters": true,
        "headerParametersJson": "={\n  \"Cookie\": $json.auth_cookie,\n  \"Content-Type\": \"application/json\"\n}",
        "bodyParametersJson": "={\n  \"chat_thread_id\": $json.resolved_thread_id,\n  \"user_request\": $node['Normalize Input'].json.user_request,\n  \"topic\": $node['Normalize Input'].json.topic,\n  \"max_rounds\": $node['Normalize Input'].json.max_rounds,\n  \"papers_per_round\": $node['Normalize Input'].json.papers_per_round,\n  \"min_papers\": $node['Normalize Input'].json.min_papers,\n  \"num_images\": $node['Normalize Input'].json.num_images,\n  \"aspect_ratio\": $node['Normalize Input'].json.aspect_ratio,\n  \"image_prompt\": $node['Normalize Input'].json.image_prompt || null,\n  \"send_slack_dm\": false,\n  \"slack_webhook_url\": null\n}",
        "options": {}
      },
      "id": "run_orchestrator",
      "name": "Run Project13 Orchestrator",
